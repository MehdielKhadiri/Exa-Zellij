include(FetchContent)
set(FQO_KOKKOS_TAG "4.5.01" CACHE STRING "Pinned Kokkos source tag when fetched")
set(FQO_KOKKOSKERNELS_TAG "4.5.01" CACHE STRING "Pinned Kokkos Kernels source tag when fetched")
if(FQO_USE_SYSTEM_KOKKOS)
  find_package(Kokkos 4 CONFIG QUIET)
endif()
if(NOT Kokkos_FOUND)
  if(NOT FQO_FETCH_DEPS)
    message(FATAL_ERROR "Install Kokkos or enable FQO_FETCH_DEPS.")
  endif()
  set(Kokkos_ENABLE_SERIAL ON CACHE BOOL "" FORCE)
  if(FQO_GPU_BACKEND STREQUAL "CUDA")
    set(Kokkos_ENABLE_CUDA ON CACHE BOOL "" FORCE)
    set(Kokkos_ENABLE_CUDA_LAMBDA ON CACHE BOOL "" FORCE)
  elseif(FQO_GPU_BACKEND STREQUAL "HIP")
    set(Kokkos_ENABLE_HIP ON CACHE BOOL "" FORCE)
  endif()
  FetchContent_Declare(kokkos
    GIT_REPOSITORY https://github.com/kokkos/kokkos.git
    GIT_TAG ${FQO_KOKKOS_TAG} GIT_SHALLOW TRUE)
  FetchContent_MakeAvailable(kokkos)
endif()
if(FQO_USE_SYSTEM_KOKKOS)
  find_package(KokkosKernels 4 CONFIG QUIET)
endif()
if(NOT KokkosKernels_FOUND)
  if(NOT FQO_FETCH_DEPS)
    message(FATAL_ERROR "Install Kokkos Kernels or enable FQO_FETCH_DEPS.")
  endif()
  set(KokkosKernels_ENABLE_ALL_COMPONENTS OFF CACHE BOOL "" FORCE)
  set(KokkosKernels_ENABLE_COMPONENT_BLAS ON CACHE BOOL "" FORCE)
  set(KokkosKernels_ENABLE_EXPLICIT_INSTANTIATION OFF CACHE BOOL "" FORCE)
  set(KokkosKernels_ADD_DEFAULT_ETI OFF CACHE BOOL "" FORCE)
  set(KokkosKernels_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
  FetchContent_Declare(kokkoskernels
    GIT_REPOSITORY https://github.com/kokkos/kokkos-kernels.git
    GIT_TAG ${FQO_KOKKOSKERNELS_TAG} GIT_SHALLOW TRUE)
  FetchContent_MakeAvailable(kokkoskernels)
endif()
if(FQO_GPU_BACKEND STREQUAL "CPU" OR
   (FQO_GPU_BACKEND STREQUAL "AUTO" AND NOT Kokkos_ENABLE_CUDA AND NOT Kokkos_ENABLE_HIP))
  find_package(Eigen3 3.3 CONFIG QUIET)
  if(NOT Eigen3_FOUND)
    if(NOT FQO_FETCH_DEPS)
      message(FATAL_ERROR "Install Eigen3 or enable FQO_FETCH_DEPS.")
    endif()
    FetchContent_Declare(eigen
      GIT_REPOSITORY https://gitlab.com/libeigen/eigen.git
      GIT_TAG 3.4.0 GIT_SHALLOW TRUE)
    FetchContent_GetProperties(eigen)
    if(NOT eigen_POPULATED)
      FetchContent_Populate(eigen)
    endif()
    add_library(fqo_eigen INTERFACE)
    target_include_directories(fqo_eigen SYSTEM INTERFACE "${eigen_SOURCE_DIR}")
    add_library(Eigen3::Eigen ALIAS fqo_eigen)
  endif()
endif()
